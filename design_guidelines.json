{
  "project_name": "CineVerse Movie Database",
  "theme_mode": "dark",
  "archetype": "Cinematic Obsidian & Warm Amber Gold",
  "typography": {
    "headline_font": "Plus Jakarta Sans, sans-serif",
    "display_font": "Bebas Neue, sans-serif",
    "body_font": "Inter, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "google_fonts_import": "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap",
    "sizes": {
      "h1_hero": "text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight",
      "h2_section": "text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight",
      "h3_subsection": "text-xl sm:text-2xl font-semibold",
      "h4_card": "text-lg sm:text-xl font-medium",
      "body": "text-sm sm:text-base leading-relaxed text-slate-300",
      "small_label": "text-xs font-semibold tracking-wider uppercase text-amber-500/90"
    }
  },
  "colors": {
    "base_background": "#0D0F12",
    "card_background": "#14181F",
    "elevated_surface": "#1E2430",
    "glass_overlay": "rgba(20, 24, 31, 0.75)",
    "primary_accent": "#F59E0B",
    "primary_hover": "#D97706",
    "secondary_accent": "#E11D48",
    "text_primary": "#F8FAFC",
    "text_secondary": "#94A3B8",
    "text_muted": "#64748B",
    "border_subtle": "rgba(255, 255, 255, 0.08)",
    "border_active": "rgba(245, 158, 11, 0.4)",
    "gold_gradient": "bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-600",
    "dark_gradient_overlay": "bg-gradient-to-t from-[#0D0F12] via-[#0D0F12]/80 to-transparent",
    "forbidden_colors": ["#7351B7", "#1B93A4"]
  },
  "visual_enhancers": {
    "border_radius": "rounded-xl",
    "card_shadow": "shadow-[0_8px_30px_rgb(0,0,0,0.5)]",
    "glow_shadow": "shadow-[0_0_25px_rgba(245,158,11,0.25)]",
    "backdrop_blur": "backdrop-blur-xl",
    "glassmorphism_class": "bg-[#14181F]/80 backdrop-blur-md border border-white/10 shadow-2xl"
  },
  "grids_and_layouts": {
    "page_container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8",
    "hero_grid": "grid grid-cols-1 lg:grid-cols-12 gap-8 items-center",
    "trending_movie_grid": "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6",
    "cast_grid": "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-4",
    "detail_layout": "grid grid-cols-1 lg:grid-cols-3 gap-8",
    "bento_features_grid": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6"
  },
  "motion": {
    "hover_lift": "transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-[0_12px_30px_rgba(0,0,0,0.8)]",
    "poster_zoom": "transition-transform duration-500 ease-out hover:scale-105",
    "button_press": "active:scale-95 transition-transform duration-150",
    "entrance_fade": "animate-in fade-in slide-in-from-bottom-4 duration-500"
  },
  "accessibility": {
    "contrast_ratio": "APCA & WCAG AA compliant (minimum 4.5:1 for body text on dark backgrounds)",
    "focus_state": "focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-[#0D0F12]",
    "hover_contrast_rule": "Always explicitly specify hover text colors alongside background changes (e.g. hover:bg-amber-500 hover:text-black)",
    "data_testid_rule": "MUST include data-testid attribute on all interactive elements (buttons, inputs, links, movie cards, rating stars, watchlist toggles)"
  },
