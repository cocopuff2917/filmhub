  "instructions_to_main_agent": [
    "1. Home Page Navigation & Hero: Build a top sticky blur header with logo 'CineVerse', nav links (Movies, Genres, Watchlist, Admin), search bar, user auth avatar/button.",
    "2. Hero Search Bar: Prominent search input with auto-suggestions filtering by title, genre, and actor name in real-time.",
    "3. Movie Sections: Display 'Trending Movies' and 'Recently Added' in responsive grids. Each card must show poster image, warm gold star rating badge, title, year, and genre chips.",
    "4. Movie Detail Page: Cinematic header with full backdrop gradient overlay, large poster, title, release date, runtime, IMDb rating, genre tags, quick actions (Add to Watchlist, Rate/Review, Watch Trailer), synopsis, Cast & Crew grid (headshot, real name, character name), and media gallery.",
    "5. Actor Detail Page: Actor headshot, bio, known for statistics, and grid of all movies they starred in.",
    "6. User Interactive Features: User signup/login simulation or JWT auth, star rating widget with review text box, personal Watchlist / Favorites page with clear remove actions.",
    "7. Filter & Sort Toolbar: Multi-select genre filter pills, year range dropdown, rating sorting (Highest rated, Recently added, Release date).",
    "8. Admin Panel Page: Secure management tab to add/edit/delete movies and actors with poster URL inputs, cast tagger, and preview modal.",
    "9. Data Test ID: Every button, link, input, tab, card, and star rating element MUST include a clear `data-testid` attribute (e.g. `data-testid='movie-card-1'`, `data-testid='search-input'`, `data-testid='add-watchlist-button'`)."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Do NOT use transparent backgrounds on headers or overlays; use dark translucent glassmorphism like bg-[#14181F]/90 backdrop-blur-md.",
    "Ensure high contrast on hover states (e.g., hover:bg-amber-500 hover:text-black).",
    "Use 2-3x generous spacing for section padding (py-12 to py-20).",
    "Include data-testid on all interactive elements in kebab-case."
  ]
}